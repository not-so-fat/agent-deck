  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.5",
    "eslint": "^9.39.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^1.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
