{
  "name": "@agent-deck/shared",
  "version": "2.5.4",
  "description": "Shared types, schemas, and utilities for Agent Deck",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
