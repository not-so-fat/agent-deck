*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Database files (keep the main one, ignore others)
*.db
*.sqlite
*.sqlite3
!agent-deck.db

# SQLite treats any path other than the exact string ":memory:" as a file, so a
# test that suffixes it leaves a real database in the repo root. Tests use the
# bare ":memory:" (private per connection); this is the backstop.
:memory:*

# Test files (keep them but ignore test outputs)
test-results/
coverage/

# Integration test logs
integration.log

# Python lib directory (but not frontend lib directory)
/lib/
# Exception: Don't ignore frontend lib directory
!apps/agent-deck/src/lib/
!packages/backend/src/lib/
